# Copy this file to .env and replace these placeholders locally.
# Never commit .env or put the API key in the Flutter application.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=replace_with_a_model_available_in_your_groq_account
GROQ_VISION_MODEL=qwen/qwen3.8-27b
VISION_MAX_UPLOAD_BYTES=5242880
EMSI_CLIP_MIN_SCORE=0.20

# Docker Compose local resource and URL configuration.
FLUTTER_API_BASE_URL=http://localhost:8000
QDRANT_VOLUME_NAME=emsi-chatbot_qdrant_storage
QDRANT_MEMORY_LIMIT=2g
QDRANT_CPUS=2.0
BACKEND_MEMORY_LIMIT=7g
BACKEND_CPUS=4.0

# Supabase project URL (used by FastAPI JWKS verification and Flutter build config).
SUPABASE_URL=https://your-project-ref.supabase.co
# Public client key only. Pass to Flutter with --dart-define; never use service_role here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key
# Server-only. Required for the FastAPI persistent-chat writer; never send to Flutter.
SUPABASE_SERVICE_ROLE_KEY=replace_with_backend_only_service_role_key
